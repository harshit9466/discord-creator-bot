DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=964889268046692414

# Database — change DB_CLIENT (pg | mysql2 | sqlite3) + install the matching driver to switch engines.
# No code changes needed; see SETUP.md.
DB_CLIENT=pg
DATABASE_URL=

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Back this up outside the repo/host the moment it's generated — losing it loses access to
# any encrypted data permanently, there is no recovery path.
ENCRYPTION_KEY=

# Where the persistent home-menu message lives, where published posts go, and the
# parent channel under which each creator's personal thread gets created
HOME_CHANNEL_ID=
FEED_CHANNEL_ID=
CREATOR_SPACES_CHANNEL_ID=

# Role required for creator-only actions (Post Content, etc.) and the mod role for admin commands
CREATOR_ROLE_ID=
MOD_ROLE_ID=

# Where applications and conduct reports land for mod review
MOD_REVIEW_CHANNEL_ID=

# Apply-to-be-a-Creator eligibility thresholds — tune anytime, just restart the bot
ELIGIBILITY_MIN_POSTS=50
ELIGIBILITY_MIN_TENURE_DAYS=90
# sfw-pics, swlflewds, femme-selfies, macho-mode
ELIGIBILITY_TRACKED_CHANNEL_IDS=992051618851848272,964889444903702588,1160589942758592572,1056131296272842832

# Mod roster flags an ACTIVE creator who hasn't posted in this many days
INACTIVITY_FLAG_DAYS=21

LOG_LEVEL=info
